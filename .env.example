# Local development settings. Copy to .env (git-ignored): `cp .env.example .env`
# Every value here is for the laptop only — never reuse them anywhere else.

# --- MySQL (docker compose) ---
MYSQL_ROOT_PASSWORD=bazaar-root-local
IDENTITY_DB_USER=bazaar_identity
IDENTITY_DB_PASSWORD=identity-local
ORDER_DB_USER=bazaar_order
ORDER_DB_PASSWORD=order-local

# --- Redis ---
REDIS_PASSWORD=redis-local

# --- Object storage (RustFS, S3-compatible) ---
STORAGE_ACCESS_KEY=bazaar-local
STORAGE_SECRET_KEY=bazaar-local-secret
STORAGE_BUCKET_IMAGES=bazaar-images
STORAGE_BUCKET_BACKUPS=bazaar-backups

# Prisma 6.19 is pinned on purpose (ADR 0011): hide its upgrade banner.
PRISMA_HIDE_UPDATE_MESSAGE=1

# --- Exchange rates (display only; money is stored and charged in USD — ADR 0012) ---
# http = live rates with stale/static fallback · static = fixed FX_STATIC_USD_VND (offline)
FX_PROVIDER=http
FX_STATIC_USD_VND=26000

# --- Connection strings used by services running on the host (`make dev`) ---
IDENTITY_DATABASE_URL=mysql://bazaar_identity:identity-local@127.0.0.1:3307/bazaar_identity
IDENTITY_SHADOW_DATABASE_URL=mysql://bazaar_identity:identity-local@127.0.0.1:3307/bazaar_identity_shadow
ORDER_DATABASE_URL=mysql://bazaar_order:order-local@127.0.0.1:3307/bazaar_order
ORDER_SHADOW_DATABASE_URL=mysql://bazaar_order:order-local@127.0.0.1:3307/bazaar_order_shadow
CATALOG_DATABASE_URL="mongodb://127.0.0.1:27018/bazaar_catalog?directConnection=true&replicaSet=rs0"
NOTIFICATION_DATABASE_URL="mongodb://127.0.0.1:27018/bazaar_notification?directConnection=true&replicaSet=rs0"
REDIS_URL=redis://:redis-local@127.0.0.1:6380
KAFKA_BROKERS=127.0.0.1:9094
STORAGE_ENDPOINT=http://127.0.0.1:9002
SMTP_HOST=127.0.0.1
SMTP_PORT=1026

# frontend-web: shared secret for on-demand ISR (POST /api/revalidate), min 32 chars
REVALIDATE_SECRET=change-me-to-a-random-32-plus-char-secret

# --- Gateway behind proxies ---
# Hops whose X-Forwarded-For the gateway trusts. Keep 0 locally: the Next rewrite forwards a
# client-sent X-Forwarded-For untouched, so trusting it would let anyone pick their rate-limit IP.
# Kubernetes sets 1: the ingress (Traefik) appends the real client IP; the gateway trusts that hop.
TRUST_PROXY_HOPS=0

# --- Service-to-service ---
# Shared key for /internal routes (gateway → catalog/order). Never proxied publicly; min 32 chars.
INTERNAL_API_KEY=internal-local-key-change-me-0123456789
