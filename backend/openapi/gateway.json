  "info": {
    "title": "Bazaar API",
    "description": "Gateway of the Bazaar marketplace. Errors use one problem-details shape.",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "bazaar_refresh"
      }
    },
    "schemas": {
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "details": {
            "type": "object",
            "additionalProperties": {}
          },
          "traceId": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "status"
        ],
        "additionalProperties": false
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "VALIDATION_FAILED",
          "UNAUTHENTICATED",
          "FORBIDDEN",
          "NOT_FOUND",
          "CONFLICT",
          "RATE_LIMITED",
          "INVALID_EVENT",
          "EMAIL_ALREADY_REGISTERED",
          "INVALID_CREDENTIALS",
          "EMAIL_NOT_VERIFIED",
          "TOKEN_EXPIRED",
          "INVALID_TOKEN",
          "ACCOUNT_SUSPENDED",
          "OUT_OF_STOCK",
          "INVALID_ORDER_TRANSITION",
          "PAYMENT_FAILED",
          "UPSTREAM_UNAVAILABLE",
          "INTERNAL"
        ]
      },
      "Locale": {
        "type": "string",
        "enum": [
          "en",
          "vi"
        ]
      },
      "UserRole": {
        "type": "string",
        "enum": [
          "SHOPPER",
          "SELLER",
          "ADMIN"
        ]
      },
      "UserStatus": {
        "type": "string",
        "enum": [
          "PENDING_VERIFICATION",
          "ACTIVE",
          "SUSPENDED"
        ]
      },
      "SellerApplicationStatus": {
        "type": "string",
        "enum": [
          "PENDING",
          "APPROVED",
          "REJECTED"
        ]
      },
      "DisplayCurrency": {
        "type": "string",
        "enum": [
          "USD",
          "VND"
        ]
      }
    }
  }
}
