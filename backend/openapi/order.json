          "payment": {
            "nullable": true,
            "type": "object",
            "properties": {
              "status": {
                "$ref": "#/components/schemas/PaymentStatus"
              },
              "cardLast4": {
                "type": "string",
                "minLength": 4,
                "maxLength": 4
              }
            },
            "required": [
              "status",
              "cardLast4"
            ],
            "additionalProperties": false
          },
          "sellerOrders": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SellerOrder"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "id",
          "status",
          "totalUsdCents",
          "cancelReason",
          "payment",
          "sellerOrders",
          "createdAt",
          "updatedAt"
        ],
        "additionalProperties": false
      },
      "OrderStatus": {
        "type": "string",
        "enum": [
          "PENDING",
          "RESERVED",
          "PAID",
          "CONFIRMED",
          "COMPLETED",
          "CANCELLED"
