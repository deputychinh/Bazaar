{
  "openapi": "3.0.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "HealthController_live",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          },
          "default": {
            "description": "Error (problem details). Translate `code`; `message` is for developers.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "tags": [
          "Health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "HealthController_ready",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          },
          "default": {
            "description": "Error (problem details). Translate `code`; `message` is for developers.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "tags": [
          "Health"
        ]
      }
    }
  },
  "info": {
    "title": "Bazaar Order API",
    "description": "Checkout, orders and seller fulfilment. Served through the gateway; errors use problem details.",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "details": {
            "type": "object",
            "additionalProperties": {}
          },
          "traceId": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "status"
        ],
        "additionalProperties": false
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "VALIDATION_FAILED",
          "UNAUTHENTICATED",
          "FORBIDDEN",
          "NOT_FOUND",
          "CONFLICT",
          "RATE_LIMITED",
          "INVALID_EVENT",
          "EMAIL_ALREADY_REGISTERED",
          "INVALID_CREDENTIALS",
          "EMAIL_NOT_VERIFIED",
          "TOKEN_EXPIRED",
          "INVALID_TOKEN",
          "ACCOUNT_SUSPENDED",
          "OUT_OF_STOCK",
          "INVALID_ORDER_TRANSITION",
          "PAYMENT_FAILED",
          "UPSTREAM_UNAVAILABLE",
          "INTERNAL"
        ]
      }
    }
  }
}
