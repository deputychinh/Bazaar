{
  "name": "bazaar-backend",
  "private": true,
  "description": "Bazaar backend: NestJS services and shared backend packages.",
  "packageManager": "npm@11.19.1",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:int": "turbo run test:int",
    "lint": "turbo run build --output-logs=errors-only && eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "globals": "17.13.0",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "unrs-resolver": false,
    "@confluentinc/kafka-javascript@1.11.0": true,
    "fsevents": false,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@scarf/scarf": false,
    "protobufjs": false
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
