// Catalog database (bazaar_catalog, MongoDB). Indexes and validators are NOT created from
// this file: they live in backend/db/catalog/schema.js (Prisma cannot create them for MongoDB).
// @unique here only enables findUnique in the client. Status columns hold contract enum values.

generator client {
  provider = "prisma-client-js"
  // Per-service output: services share node_modules, so the default location would collide.
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("CATALOG_DATABASE_URL")
}

/// Text in both languages; a missing `vi` falls back to `en` (plan §2B).
type LocalizedText {
  en String
  vi String?
}

type ProductVariant {
  sku           String
  priceUsdCents Int
  stock         Int
  attributes    Json?
}

type ProductImage {
  key String
  alt LocalizedText?
}

type Rating {
  average Float
  count   Int
}

model Category {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  slug      String        @unique
  name      LocalizedText
  parentId  String?       @db.ObjectId
  path      String
  sortOrder Int
  createdAt DateTime      @default(now())

  @@map("categories")
}

model Shop {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  sellerId    String         @unique
  slug        String         @unique
  name        String
  description LocalizedText?
  status      String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("shops")
}

model Product {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  shopId           String           @db.ObjectId
  sellerId         String
  slug             String           @unique
  title            LocalizedText
  description      LocalizedText
  categoryId       String           @db.ObjectId
  attributes       Json?
  variants         ProductVariant[]
  images           ProductImage[]
  status           String
  /// Cheapest variant price, kept in sync for filtering and sorting.
  minPriceUsdCents Int
  totalStock       Int
  rating           Rating
  hiddenReason     String?
  publishedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@map("products")
}

/// Transactional outbox (plan DS-04), written in the same transaction as the change.
model OutboxMessage {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  topic     String
  msgKey    String    @map("msg_key")
  value     String
  headers   Json
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@map("outbox")
}

/// Idempotency for consumed events (plan DS-05); _id is the event id.
model ProcessedEvent {
  id          String   @id @map("_id")
  processedAt DateTime @default(now())

  @@map("processed_events")
}
