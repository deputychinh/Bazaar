{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "tasks": {
    "generate": {
      "cache": false
    },
    "build": {
      "dependsOn": ["generate", "^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["generate", "^build"]
    },
    "test": {
      "dependsOn": ["generate", "^build"],
      "outputs": ["coverage/**"]
    },
    "test:int": {
      "dependsOn": ["generate", "^build"],
      "cache": false
    }
  }
}
